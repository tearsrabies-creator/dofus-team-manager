{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dofus Team Manager",
  "version": "0.3.0",
  "identifier": "com.dofusteammanager.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dofus Team Manager",
        "width": 420,
        "height": 500,
        "decorations": false,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "pip",
        "url": "pip.html",
        "title": "Dofus Team Manager — bandeau",
        "width": 240,
        "height": 40,
        "visible": false,
        "focusable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzRTQzODE3NzUwQjhEQTQKUldTa2pRdDFGemprSTNCRjN4dnA4Yjd1V3dxUUpCcW9YMiswN0ZTdCt1cjJQb0pidXJZY0tnUVkK",
      "endpoints": [
        "https://github.com/tearsrabies-creator/dofus-team-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
