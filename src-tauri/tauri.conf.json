{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dofus Organizer",
  "version": "0.1.0",
  "identifier": "com.dofusorganizer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dofus Organizer",
        "width": 420,
        "height": 500,
        "decorations": false,
        "resizable": false,
        "maximizable": false
      },
      {
        "label": "pip",
        "url": "pip.html",
        "title": "Dofus Organizer — bandeau",
        "width": 240,
        "height": 40,
        "visible": false,
        "focusable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
